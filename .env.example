# Optional. Defaults to INFO. Use DEBUG to see per-request API details
# (Gmail, Calendar, Sheets, YNAB, Whoop).
MGDIO_LOG_LEVEL=INFO

# Optional. Set to 1 to run the opt-in integration tests that hit real
# external APIs (Gmail, Calendar, Sheets, YNAB, Whoop). They require a
# completed auth flow on this machine. Leave unset normally; the standard
# unit suite uses in-memory fakes and never touches your real accounts.
MGDIO_RUN_INTEGRATION=

# Optional. Override the YNAB integration test recipient/payer for any
# tests that need a target address. Defaults to the authenticated account.
MGDIO_INTEGRATION_TO=

# Optional. The OAuth redirect URI for `mgdio auth whoop`. Must match
# exactly what's registered in your Whoop developer app. Defaults to
# http://localhost:8765/callback -- only set this if you registered a
# different port or path.
MGDIO_WHOOP_REDIRECT_URI=http://localhost:8765/callback

# Optional. The default Google account "profile" slug for this project,
# used when a call doesn't pass --profile / profile=. Must match a slug you
# authorized via `mgdio auth google --profile <slug>`. If only one profile
# is configured, it is used automatically and this can stay unset.
MGDIO_GOOGLE_PROFILE=

# Credential vault (mgdvault). mgdio stores every token / API key in an
# encrypted KeePass file shared by all your projects, unlocked by this one
# passphrase. Required. Prefer exporting it from your shell profile so there
# is a single copy; putting it here works too (this file is gitignored).
MGDVAULT_PASSWORD=

# Optional. Where the vault file lives. Defaults to the per-user data dir:
# ~/Library/Application Support/mgdvault/vault.kdbx (macOS),
# %LOCALAPPDATA%\mgdvault\vault.kdbx (Windows),
# ~/.local/share/mgdvault/vault.kdbx (Linux). Point it at a file you
# copied from another machine to reuse that machine's tokens.
MGDVAULT_PATH=

# Optional. Set to "keyring" to use the OS credential manager (macOS
# Keychain / Windows Credential Manager / Linux Secret Service) instead of
# the KeePass file. Not recommended for cron/headless use.
MGDVAULT_BACKEND=
